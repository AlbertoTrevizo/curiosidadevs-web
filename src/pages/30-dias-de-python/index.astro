---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const dias = (await getCollection("dias")).sort((a, b) => a.data.dia - b.data.dia);
---
<Base titulo="30 días de Python">
  <h1>30 días de Python</h1>
  <p class="mut">Elige un día y practica sus ejercicios.</p>
  <ul class="tarjetas">
    {dias.map((d) => (
      <li><a class="tarjeta" href={`${base}/30-dias-de-python/${d.id}/`}>
        <h3>Día {d.data.dia} · {d.data.tema}</h3><p>{d.data.ejercicios.length} ejercicios</p></a></li>
    ))}
  </ul>
</Base>
