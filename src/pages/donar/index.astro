---
import Base from "../../layouts/Base.astro";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---
<Base titulo="Apoya a Curiosida.devs" descripcion="Tu donación ayuda a seguir creando contenido gratis de programación en español.">
  <p class="volver"><a href={`${base}/`}>← Volver al inicio</a></p>
  <form class="donar" method="post" action={`${base}/api/donar`}>
    <svg class="corazon" viewBox="0 0 24 24" width="44" height="44" aria-hidden="true"><path d="M12 20.5s-7.5-4.6-9.6-9.2C.9 8 2.7 4 6.6 4c2.2 0 3.6 1.2 4.4 2.5h2C13.8 5.2 15.2 4 17.4 4c3.9 0 5.7 4 4.2 7.3-2.1 4.6-9.6 9.2-9.6 9.2Z" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linejoin="round"/></svg>
    <h1>Apoya a Curiosida.devs</h1>
    <p class="mut">Tu donación me ayuda a seguir creando contenido gratis de programación en español.</p>
    <fieldset>
      <legend class="mut">Elige una cantidad</legend>
      <div class="opciones">
        {[5, 10, 25].map((n) => (
          <label class="op"><input type="radio" name="monto" value={n} checked={n === 10} /><span>${n}</span></label>
        ))}
      </div>
    </fieldset>
    <label class="mut" for="otro">Otra cantidad</label>
    <div class="otro"><span aria-hidden="true">$</span><input id="otro" name="otro" type="number" min="1" max="1000" step="1" inputmode="numeric" placeholder="0" /></div>
    <small class="mut">Mínimo 1 USD</small>
    <button type="submit">Donar</button>
    <small class="mut">🔒 Pago seguro con Stripe</small>
  </form>
</Base>
<script>
  // Elegir un botón borra "otra cantidad", y escribir una cantidad quita la selección.
  const otro = document.querySelector<HTMLInputElement>("#otro")!;
  const radios = document.querySelectorAll<HTMLInputElement>('input[name="monto"]');
  otro.addEventListener("input", () => radios.forEach((r) => (r.checked = false)));
  radios.forEach((r) => r.addEventListener("change", () => (otro.value = "")));
</script>
<style>
  .volver { text-align:center; margin:0 0 16px; }
  .volver a { color:var(--mut); text-decoration:none; }
  .donar { max-width:460px; margin:0 auto; background:var(--panel); border:1px solid var(--borde); border-radius:20px; box-shadow:var(--sombra);
    padding:32px 24px; display:flex; flex-direction:column; align-items:center; text-align:center; gap:10px; }
  .corazon { color:var(--rojo); }
  .donar h1 { margin:0; }
  .donar > p { margin:0 0 8px; font-size:1.05rem; }
  fieldset { border:0; padding:0; margin:0 0 8px; }
  legend { margin:0 auto 10px; }
  .opciones { display:flex; gap:12px; justify-content:center; }
  .op input { position:absolute; opacity:0; }
  .op span { display:block; min-width:64px; padding:10px 16px; border:1px solid var(--borde); border-radius:999px; cursor:pointer; font-weight:600; }
  .op input:checked + span { background:var(--t); color:#fff; border-color:var(--t); }
  .op input:focus-visible + span, .otro:focus-within { outline:2px solid var(--acc); outline-offset:2px; }
  .otro { display:flex; align-items:center; gap:8px; width:200px; padding:10px 16px; border:1px solid var(--borde); border-radius:999px; color:var(--mut); }
  .otro input { flex:1; min-width:0; border:0; outline:0; font:inherit; text-align:center; background:none; color:var(--t); }
  button { margin-top:14px; width:240px; padding:12px; border-radius:999px; border:2px solid var(--acc); background:var(--t); color:#fff;
    font:inherit; font-size:1.1rem; font-weight:700; cursor:pointer; box-shadow:0 8px 24px rgba(193,127,94,.35); }
  button:hover, button:focus-visible { background:#2a2a2a; }
</style>
