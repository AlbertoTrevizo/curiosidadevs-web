---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
export async function getStaticPaths() {
  return (await getCollection("guias")).map((g) => ({ params: { slug: g.id }, props: { g } }));
}
const { g } = Astro.props;
const { Content } = await render(g);
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---
<Base titulo={g.data.titulo} descripcion={g.data.descripcion}>
  <p><a href={`${base}/guias/`}>← Todas las guías</a></p>
  <h1>{g.data.titulo}</h1>
  <article class="prosa"><Content /></article>
</Base>
